{
  "$class": "com.trustblocks.lifecycle@1.0.0.Lifecycle",
  "stateType": "ContractorPayRequestState",
  "states": [
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "RECEIVED"},
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "INSPECTED"},
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "CERTIFIED"},
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "APPROVED"},
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "OVERDUE"},
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "PAID", "accepting": true},
    {"$class": "com.trustblocks.lifecycle@1.0.0.LifecycleState", "name": "RETURNED", "accepting": true}
  ],
  "transitions": [
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "PayRequestReceived", "from": [], "to": "RECEIVED",
     "requires": [{"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Receipt", "authority": "RECEIVE_PAY_APPLICATIONS"}]},
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "InspectionCertified", "from": ["RECEIVED"], "to": "INSPECTED",
     "requires": [{"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Attestation", "authority": "CERTIFY_INSPECTIONS"},
                  {"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Receipt", "authority": "RECEIVE_INSPECTION_REPORTS"}]},
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "PayRequestCertified", "from": ["INSPECTED"], "to": "CERTIFIED",
     "requires": [{"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Attestation", "authority": "CERTIFY_PAY_APPLICATIONS"}]},
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "PaymentApproved", "from": ["CERTIFIED"], "to": "APPROVED",
     "requires": [{"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Attestation", "authority": "APPROVE_PAYMENTS"}]},
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "PaymentOverdue", "from": ["APPROVED"], "to": "OVERDUE",
     "requires": [], "afterDays": 30},
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "PaymentCertified", "from": ["APPROVED", "OVERDUE"], "to": "PAID",
     "requires": [{"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Attestation", "authority": "CERTIFY_PAYMENTS"}]},
    {"$class": "com.trustblocks.lifecycle@1.0.0.Transition",
     "event": "PayRequestReturned", "from": ["RECEIVED", "INSPECTED", "CERTIFIED"], "to": "RETURNED",
     "requires": [{"$class": "com.trustblocks.lifecycle@1.0.0.Certification",
                   "credential": "Attestation", "authority": "CERTIFY_PAY_APPLICATIONS"}]}
  ]
}
